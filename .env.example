# Django
# Generate a unique value for every deployment. Never commit the real key.
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Database
# Use "sqlite" for local development. Leave it empty to use PostgreSQL.
DB_ENGINE=sqlite
POSTGRES_DB=task_flow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Telegram (optional)
TELEGRAM_SUPPORT_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TaskFlowBot
TELEGRAM_WEBHOOK_SECRET=

# Email
# Console backend is safe for local development and does not send real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TaskFlow <noreply@example.com>
